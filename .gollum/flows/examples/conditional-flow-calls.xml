<?xml version="1.0" encoding="UTF-8"?>
<!--
Conditional Flow Calls Example
Demonstrates: Conditional execution, module calls (main.xml entry point), sub-flow calls
-->
<flow name="conditional-flow-calls" version="1.0">
    <description>
        Shows conditional flow execution and module calls.
        Demonstrates calling module entry points (main.xml) and sub-flows.
    </description>

    <input>
        <string name="scan_type" required="true" enum="quick,full,deep" />
        <string name="target_dir" required="true" />
        <bool name="run_security_scan" default="false" />
    </input>

    <output>
        <string name="status" />
        <string name="summary" />
        <int name="complexity_score" />
    </output>

    <context>
        <object name="results">
            <string name="status" />
            <string name="summary" />
        </object>

        <int name="complexity_score" />
    </context>

    <computed>
        <bool name="is_deep_scan" eval="EQ(input.scan_type, 'deep')" />
        <bool name="is_quick_scan" eval="EQ(input.scan_type, 'quick')" />
    </computed>

    <agents>
        <agent name="coordinator" model="anthropic/claude-opus-4-6">
            <prompt>Workflow coordinator</prompt>
            <temperature>0.0</temperature>
        </agent>
    </agents>

    <states>
        <state name="init" initial="true">
            <steps>
                <step type="llm" agent="coordinator">
                    <prompt><![CDATA[
                        Scan type: ${input.scan_type}
                        Target: ${input.target_dir}
                        Run security: ${input.run_security_scan}

                        Plan the execution based on scan type.
                        Use emit_log to report your plan.
                    ]]></prompt>
                    <tools>emit_log, get_context</tools>
                    <timeout>30s</timeout>
                </step>

                <!-- Conditional flow call: Only execute for deep scans -->
                <call ref="code-analysis/security-scan" timeout="300s" when="EQ(computed.is_deep_scan, true)">
                    <input>
                        <string name="target_dir" assignFrom="input.target_dir" />
                        <string name="scan_type" assignFrom="input.scan_type" />
                    </input>
                    <output>
                        <int name="issues" assignTo="context.results.status" />
                    </output>
                    <on-error state="error" />
                </call>

                <!-- Conditional flow call: Full analysis using module entry point -->
                <call ref="code-analysis" timeout="300s" when="EQ(input.run_security_scan, true)">
                    <input>
                        <string name="target_dir" assignFrom="input.target_dir" />
                        <string name="scan_type" assignFrom="input.scan_type" />
                    </input>
                    <output>
                        <int name="complexity_score" assignTo="context.complexity_score" />
                    </output>
                    <on-error state="error" />
                </call>

                <!-- Otherwise fallback: complexity check only -->
                <call ref="code-analysis/complexity-check" timeout="120s" when="EQ(computed.is_quick_scan, true)">
                    <input>
                        <string name="target_dir" assignFrom="input.target_dir" />
                    </input>
                    <output>
                        <int name="score" assignTo="context.complexity_score" />
                    </output>
                    <on-error state="error" />
                </call>
            </steps>

            <transitions>
                <transition to="done" />
            </transitions>
        </state>

        <state name="error">
            <steps>
                <step type="llm" agent="coordinator">
                    <prompt><![CDATA[
                        Conditional flow failed:
                        Step: ${sys.error.step_name}
                        Error: ${sys.error.message}

                        Use emit_log to report.
                    ]]></prompt>
                    <tools>emit_log</tools>
                </step>
            </steps>
        </state>

        <state name="done" />
    </states>
</flow>
