<?xml version="1.0" encoding="UTF-8"?>
<!-- Simplified Flow Example -->
<flow name="simplified-flow-example" version="1.0">
    <description>
        Minimal flow demonstrating core concepts.
        Note: Fragments removed - use sub-flows instead
    </description>

    <input>
        <string name="target" required="true" />
    </input>

    <output>
        <int name="complexity_score" />
        <string name="assessment" />
    </output>

    <context>
        <int name="complexity_score" />
        <string name="assessment" />
    </context>

    <computed>
        <bool name="is_complex" eval="GT(context.complexity_score, 10)" />
    </computed>

    <agents>
        <agent name="analyzer" model="anthropic/claude-opus-4-6">
            <prompt>Code complexity analyzer</prompt>
            <temperature>0.0</temperature>
        </agent>
    </agents>

    <states>
        <state name="analyze" initial="true">
            <steps>
                <!-- Analyze complexity -->
                <step type="llm" agent="analyzer">
                    <prompt><![CDATA[
                        Analyze ${input.target} and provide complexity score (1-20).
                        Use set_context_field("complexity_score", <score>)
                    ]]></prompt>
                    <tools>set_context_field, get_context, emit_log</tools>
                    <timeout>60s</timeout>
                </step>
            </steps>

            <transitions>
                <transition to="done" />
            </transitions>
        </state>

        <state name="done" />
    </states>
</flow>
