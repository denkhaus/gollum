<?xml version="1.0" encoding="UTF-8"?>
<!--
Step Types Example
Demonstrates: func, shell, llm, mcp with unified output syntax
-->
<flow name="step-types-example" version="1.0">
    <description>
        Shows all step types with clear naming:
        - func: All Go function calls (built-in stdlib OR extension)
        - shell: Bash/shell commands
        - llm: LLM agent calls
        - mcp: MCP tool calls
    </description>

    <input>
        <string name="target_dir" required="true" />
        <string name="input_text" />
        <string name="forgejo_owner" default="denkhaus" />
        <string name="forgejo_repo" default="gollum" />
        <int name="pr_index" default="0" />
    </input>

    <output>
        <string name="upper_text" />
        <int name="item_count" />
        <string name="test_output" />
        <string name="analysis_result" />
        <bool name="has_error" />
    </output>

    <context>
        <string name="upper_text" />
        <int name="item_count" />
        <string name="test_output" />
        <string name="analysis_result" />
        <bool name="has_error" />
        <string name="pr_title" />
        <string name="pr_state" />
        <string name="head_branch" />
        <object name="pr_details" />
    </context>

    <extensions>
        <function name="CustomAnalyze" package="github.com/denkhaus/gollum/flows/custom">
            <description>Custom analysis function (package registered at startup)</description>
        </function>
    </extensions>

    <agents>
        <agent name="analyzer" model="anthropic/claude-opus-4-6">
            <prompt>Text analyzer</prompt>
            <temperature>0.0</temperature>
        </agent>
    </agents>

    <states>
        <state name="demonstrate" initial="true">
            <steps>
                <!-- === SHELL: Bash commands === -->
                <step type="shell" name="run-tests">
                    <cmd><![CDATA[go test ${input.target_dir} -v 2>&1]]></cmd>
                    <result>
                        <string path="stdout" assignTo="context.test_output" />
                    </result>
                    <timeout>300s</timeout>
                    <on-error state="error" />
                </step>

                <!-- === FUNC: Built-in Go stdlib (MUST have output) === -->
                <step type="func" function="strings.ToUpper">
                    <description>Convert to uppercase - built-in Go function</description>
                    <params>
                        <param name="s" assignFrom="input.input_text" />
                    </params>
                    <result assignTo="output.upper_text" />
                </step>

                <step type="func" function="len">
                    <description>Count items - built-in Go function</description>
                    <params>
                        <param name="v" assignFrom="input.input_text" />
                    </params>
                    <result assignTo="output.item_count" />
                </step>

                <step type="func" function="strings.Contains">
                    <description>Check substring - built-in Go function</description>
                    <params>
                        <param name="s" assignFrom="input.input_text" />
                        <param name="substr" assignFrom="sys.error" />
                    </params>
                    <result assignTo="output.has_error" />
                </step>

                <!-- === FUNC: Extension function (registered at startup) === -->
                <step type="func" function="CustomAnalyze">
                    <description>Call custom extension - registered at application startup</description>
                    <params>
                        <param name="target" assignFrom="input.target_dir" />
                    </params>
                    <result assignTo="output.analysis_result" />
                    <timeout>60s</timeout>
                    <on-error state="error" />
                </step>

                <!-- === LLM: Agent calls === -->
                <step type="llm" agent="analyzer">
                    <prompt><![CDATA[
                        Input: ${input.input_text}
                        Length: ${context.item_count}
                        Contains error: ${context.has_error}

                        Provide analysis.
                    ]]></prompt>
                    <tools>set_context_field, emit_log</tools>
                    <timeout>60s</timeout>
                </step>

                <!-- === MCP: Tool calls with unified path syntax === -->
                <step type="mcp" tool="forgejo/get_pull_request_by_index">
                    <params>
                        <param name="owner" assignFrom="input.forgejo_owner" />
                        <param name="repo" assignFrom="input.forgejo_repo" />
                        <param name="index" assignFrom="input.pr_index" />
                    </params>
                    <result>
                        <string path="title" assignTo="context.pr_title" />
                        <string path="state" assignTo="context.pr_state" />
                        <string path="head.ref" assignTo="context.head_branch" />
                    </result>
                    <timeout>30s</timeout>
                    <on-error state="error" />
                </step>
            </steps>

            <transitions>
                <transition to="done" />
            </transitions>
        </state>

        <state name="error">
            <steps>
                <step type="llm" agent="analyzer">
                    <prompt><![CDATA[
                        Step failed:
                        Step: ${sys.error.step_name}
                        Error: ${sys.error.message}

                        Use emit_log to report.
                    ]]></prompt>
                    <tools>emit_log</tools>
                </step>
            </steps>
        </state>

        <state name="done" />
    </states>
</flow>
