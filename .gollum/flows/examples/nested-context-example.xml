<?xml version="1.0" encoding="UTF-8"?>
<!--
Nested context & computed fields example
Demonstr: Nested objects, computed fields, expression syntax
-->
<flow name="nested-context-example" version="1.0">
    <description>
        Shows nested context objects and calculated field syntax.
    </description>

    <input>
        <string name="target" required="true" />
    </input>

    <output>
        <int name="line_count" />
        <bool name="is_large" />
        <bool name="needs_refactor" />
        <string name="assessment" />
    </output>

    <context>
        <!-- Simple fields -->
        <int name="line_count" />
        <int name="function_count" />

        <!-- Nested object for organization) -->
        <object name="metrics">
            <object name="testing">
                <int name="errors" />
                <int name="warnings" />
            </object>
            <object name="coverage">
                <float name="percentage" />
            </object>
        </object>

        <!-- Internal field for parsing -->
        <string name="line_count_output" />
    </context>

    <computed>
        <bool name="is_large" eval="GT(context.line_count, 500)" />
        <bool name="has_errors" eval="GT(context.metrics.testing.errors, 0)" />
        <bool name="needs_refactor" eval="AND(computed.is_large, computed.has_errors)" />
        <bool name="is_covered" eval="GTE(context.metrics.coverage.percentage, 80.0)" />
    </computed>

    <agents>
        <agent name="analyzer" model="anthropic/claude-opus-4-6">
            <prompt>Code analyzer</prompt>
            <temperature>0.0</temperature>
        </agent>
    </agents>

    <states>
        <state name="analyze" initial="true">
            <steps>
                <!-- Calculate metrics -->
                <step type="shell">
                    <cmd><![CDATA[wc -l ${input.target} | awk '{print $1}' | tail -1]]></cmd>
                    <result>
                        <string path="stdout" assignTo="context.line_count_output" />
                    </result>
                    <timeout>60s</timeout>
                    <on-error state="error" />
                </step>

                <!-- Parse line count -->
                <step type="func" function="strconv.Atoi">
                    <params>
                        <param name="s" assignFrom="context.line_count_output" />
                    </params>
                    <result assignTo="output.line_count" />
                </step>

                <!-- Use computed values in LLM prompt -->
                <step type="llm" agent="analyzer">
                    <prompt><![CDATA[
                        Target: ${input.target}
                        Lines: ${context.line_count}
                        Functions: ${context.function_count}
                        Large: ${computed.is_large}
                        Has errors: ${computed.has_errors}
                        Needs refactor: ${computed.needs_refactor}
                        Covered: ${computed.is_covered}

                        Provide assessment.
                        Use set_context_field to report.
                    ]]></prompt>
                    <tools>set_context_field, get_context, emit_log</tools>
                    <timeout>60s</timeout>
                </step>
            </steps>

            <transitions>
                <transition to="done" />
            </transitions>
        </state>

        <state name="error">
            <steps>
                <step type="llm" agent="analyzer">
                    <prompt><![CDATA[
                        Analysis failed for target: ${input.target}
                        Error: ${sys.error.message}

                        Provide error assessment.
                    ]]></prompt>
                    <tools>emit_log</tools>
                </step>
            </steps>
            <transitions>
                <transition to="done" />
            </transitions>
        </state>

        <state name="done" />
    </states>
</flow>
