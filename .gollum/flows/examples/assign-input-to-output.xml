<?xml version="1.0" encoding="UTF-8"?>
<!--
Assign Input to Output
Simplest test - pass input values directly to output
-->
<flow name="assign-input-to-output" version="1.0">
    <description>
        Simplest assign flow - copies input to output.
        Test with: gollum flow run assign-input-to-output.xml -i "message=Hello World"
    </description>

    <input>
        <string name="message" default="Hello" />
    </input>

    <output>
        <string name="result" />
    </output>

    <states>
        <state name="assign" initial="true">
            <steps>
                <step type="func" function="assign">
                    <params>
                        <param name="from" value="input.message" />
                        <param name="to" value="output.result" />
                    </params>
                </step>
            </steps>
            <transitions>
                <transition to="done" />
            </transitions>
        </state>
        <state name="done" />
    </states>
</flow>
