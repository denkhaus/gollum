<?xml version="1.0" encoding="UTF-8"?>
<flow name="startup-flow" version="1.0">
    <description>
        This is the default flow that is invoked at gollum startup.
        For the time being this flow is solely for testing purposes.
    </description>

    <input>
        <string name="location" required="true" default="London" />
    </input>

    <output>
        <string name="the_current_time" from="context.the_current_time" />
        <bool name="is_afternoon" from="computed.is_afternoon" />
    </output>

    <context>
        <string name="the_current_time" />
        <int name="hour" />
    </context>

    <computed>
        <bool name="is_afternoon" eval="GT(context.hour, 12)" />
    </computed>

    <agents>
        <agent name="startup" model="anthropic/glm-4.7">
            <prompt>You are a helpfull agent</prompt>
            <temperature>0.0</temperature>
        </agent>
    </agents>

    <states>
        <state name="get current time" initial="true">
            <steps>
                <step type="llm" agent="startup">
                    <prompt><![CDATA[
                        What is the time in ${input.location}?:
                        Use the `set_context_field` tool to set:
                        1. The current time as string to the context like so: set_context_field("the_current_time", <DD.MM.YY HH:mm:ss>).
                        2. The hour to the context like so: set_context_field("hour", <hour>).
                    ]]></prompt>
                    <tools>set_context_field,current_time</tools>
                    <timeout>60s</timeout>
                </step>
            </steps>

            <transitions>
                <transition to="done" />
            </transitions>
        </state>

        <state name="done" />
    </states>
</flow>
