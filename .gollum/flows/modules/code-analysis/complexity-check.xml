<?xml version="1.0" encoding="UTF-8"?>
<!-- Complexity Check Flow (Internal to code-analysis module) -->
<flow name="complexity-check" version="1.0">
    <description>Internal flow: Calculate code complexity score.</description>

    <input>
        <string name="target_dir" required="true" />
    </input>

    <output>
        <float name="score" />
    </output>

    <context>
        <string name="target_dir" required="true" />
        <float name="score" />
    </context>

    <states>
        <state name="calculate" initial="true">
            <steps>
                <step type="shell" name="run-gocyclo">
                    <cmd><![CDATA[gocyclo -avg ${input.target_dir} | awk '/Average/{print $2}']]></cmd>
                    <result>
                        <string path="stdout" assignTo="output.score" />
                    </result>
                    <timeout>5s</timeout>
                    <on-error state="error" />
                </step>

                <!--
                This is not needed since we have buildin type conversion between assignments
                <step type="func" function="Atof64">
                    <params>
                        <param name="s" assignFrom="context.cyclomatic_output" />
                    </params>
                    <result assignTo="output.score" />
                </step> -->
            </steps>

            <transitions>
                <transition to="done" />
            </transitions>
        </state>

        <state name="error">
            <steps>
                <step type="llm" agent="system">
                    <prompt><![CDATA[
                        Complexity check failed:
                        Error: ${sys.error.message}
                        ExitCode: ${sys.error.exitCode}

                        Use emit_log to report the error.
                    ]]></prompt>
                    <tools>emit_log</tools>
                </step>
            </steps>
        </state>

        <state name="done" />
    </states>
</flow>
