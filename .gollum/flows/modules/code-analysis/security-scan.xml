<?xml version="1.0" encoding="UTF-8"?>
<!-- Security Scan Flow (Internal to code-analysis module) -->
<flow name="security-scan" version="1.0">
    <description>Internal flow: Security vulnerability scanning.</description>

    <input>
        <string name="target_dir" required="true" />
        <string name="scan_type" default="full" />
    </input>

    <output>
        <int name="issues" />
    </output>

    <context>
        <string name="target_dir" required="true" />
        <string name="scan_type" default="full" />
        <int name="issues" />
        <string name="scan_output" />
        <int name="exit_code" />
    </context>

    <extensions>
        <function name="JSONCount" package="github.com/denkhaus/gollum/flows/jsonutil">
            <description>Count items at JSON path</description>
        </function>
    </extensions>

    <states>
        <state name="scan" initial="true">
            <steps>
                <step type="shell" name="run-gosec">
                    <cmd><![CDATA[gosec -fmt=json ${input.target_dir}]]></cmd>
                    <result>
                        <string name="stdout" assignTo="context.scan_output" />
                        <int name="exit_code" assignTo="context.exit_code" />
                    </result>
                    <timeout>120s</timeout>
                    <on-error state="error" />
                </step>

                <step type="func" function="JSONCount">
                    <params>
                        <param name="json" assignFrom="context.scan_output" />
                        <param name="path" assignFrom="results" />
                    </params>
                    <result assignTo="output.issues" />
                </step>
            </steps>

            <transitions>
                <transition to="done" />
            </transitions>
        </state>

        <state name="error">
            <steps>
                <step type="func" function="fmt.Sprintf">
                    <params>
                        <param name="format" assignFrom="Security scan failed: %s" />
                        <param name="a" assignFrom="sys.error.message" />
                    </params>
                </step>
            </steps>
        </state>

        <state name="done" />
    </states>
</flow>
