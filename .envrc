# OPENAI
# export GOLLUM_OPENAI_API_KEY=$(gopass show -o arbeit/llm/zai/api_key)
# export GOLLUM_OPENAI_BASE_URL=https://api.z.ai/api/paas/v4
# export GOLLUM_OPENAI_MODEL=glm-4.7

# ANTHROPIC
export GOLLUM_ANTHROPIC_API_KEY=$(gopass show -o arbeit/llm/zai/api_key)
export GOLLUM_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
export GOLLUM_ANTHROPIC_MODEL=glm-4.7

# MCP (Model Context Protocol) Configuration
# Timeout for shell command interpolation during config loading (gopass, etc.)
# Default: 30s, Min: 1s, Max: 300s (5 minutes)
export GOLLUM_MCP_COMMAND_TIMEOUT_SECONDS=30

# Timeout for MCP client initialization (server startup and handshake)
# Default: 60s, Min: 10s, Max: 300s (5 minutes)
# Some MCP servers (chrome-devtools, tavily) may take time to start
export GOLLUM_MCP_CLIENT_INIT_TIMEOUT_SECONDS=60

# LOG_LEVEL (debug, info, warn, error)
export GOLLUM_LOG_LEVEL=debug
